rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function uidNow() { return request.auth.uid; }
    function messPath(messId) { return /databases/$(database)/documents/messes/$(messId); }
    function personPath(messId, uid) { return /databases/$(database)/documents/messes/$(messId)/people/$(uid); }

    function isMember(messId) { return signedIn() && exists(personPath(messId, uidNow())); }
    function myRole(messId)   { return get(personPath(messId, uidNow())).data.role; }
    function isHead(messId)   { return isMember(messId) && myRole(messId) == 'head'; }
    function isAdmin(messId)  { return isMember(messId) && myRole(messId) in ['head', 'admin']; }
    function isEditor(messId) { return isAdmin(messId); }    // only the mess head and admins add purchases

    // ---------- user profiles (name + photo, current mess, pending request) ----------
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && uidNow() == uid;
    }

    // ---------- one account per name ----------
    // names/{lower-case name} -> who owns it. Anyone can check if a name is free.
    match /names/{key} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == uidNow();
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == uidNow();
    }

    // ---------- mess name + head name (shown on the invite screen) ----------
    // Can only be opened by id (from an invite link). Nobody can list or search messes.
    match /directory/{messId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && getAfter(messPath(messId)).data.headUid == uidNow()
        && request.resource.data.headUid == uidNow();
      allow update: if isAdmin(messId)
        && request.resource.data.headUid == resource.data.headUid;
      allow delete: if isHead(messId);
    }

    // ---------- invite links: /invites/{code} -> which mess ----------
    // Anyone signed in can open ONE code they already have; nobody can list codes.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == uidNow()
        && request.resource.data.role == 'editor'
        && getAfter(personPath(request.resource.data.messId, uidNow())).data.role == 'head';
      // each mess head has one permanent link; it goes only when the head deletes the mess
      allow delete: if signedIn() && resource.data.createdBy == uidNow()
        && !exists(messPath(resource.data.messId));
    }

    // ---------- a mess ----------
    match /messes/{messId} {
      allow read: if isMember(messId);
      // Whoever creates a mess is its head
      allow create: if signedIn() && request.resource.data.headUid == uidNow();
      // Head and admins edit name, logo, currency.
      // Nobody can change who the head is or the permanent invite link.
      allow update: if isAdmin(messId)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['headUid', 'inviteCode', 'defaultRole']);
      allow delete: if isHead(messId);

      // ----- people who use the app in this mess: role lives here -----
      match /people/{uid} {
        allow read: if isMember(messId);

        allow create: if signedIn() && request.resource.data.role in ['head', 'admin', 'editor', 'viewer'] && (
          // 1. The head adds themselves while creating the mess
          (uid == uidNow()
            && request.resource.data.role == 'head'
            && getAfter(messPath(messId)).data.headUid == uidNow())
          // 2. Someone joins with a valid invite link of THIS mess, with the role the head chose for that link
          || (uid == uidNow()
            && request.resource.data.code is string
            && exists(/databases/$(database)/documents/invites/$(request.resource.data.code))
            && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.messId == messId
            && request.resource.data.role == get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.role)
          // 3. The head approves a join request
          || (isHead(messId) && request.resource.data.role != 'head')
        );

        // Only the head makes / removes admins. A person may only change their own display name.
        allow update: if (isHead(messId) && uid != uidNow() && request.resource.data.role in ['admin', 'editor'])
          || (uid == uidNow()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));

        // The head removes anyone; admins remove normal members; anyone except the head can leave.
        allow delete: if (isHead(messId) && uid != uidNow())
          || (uid == uidNow() && resource.data.role == 'head' && !exists(messPath(messId)))   // head, after deleting the mess
          || (isAdmin(messId) && uid != uidNow() && resource.data.role in ['editor', 'viewer'])
          || (uid == uidNow() && resource.data.role != 'head');
      }

      // ----- purchases -----
      match /purchases/{id} {
        allow read: if isMember(messId);
        allow create: if isAdmin(messId)
          && request.resource.data.addedBy == uidNow()
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
        allow update, delete: if isAdmin(messId);
      }
    }
  }
}
